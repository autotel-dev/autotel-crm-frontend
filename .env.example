# Copy to .env on each server and fill in, then run `npm run build`.
# .env is gitignored; never commit real values.

# Backend API, including /api/v1 (use https on live)
REACT_APP_API_BASE_URL=
# Where uploaded images are served from; defaults to the API host without /api/v1
REACT_APP_IMAGE_BASE_URL=
# Socket.io server
REACT_APP_SOCKET_URL=
# Google Maps JavaScript API key (restrict it to your domains in Google Cloud)
REACT_APP_GOOGLE_MAPS_API_KEY=

# Don't publish source maps with the production build
GENERATE_SOURCEMAP=false
